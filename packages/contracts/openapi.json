            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          },
          "record_version": {
            "title": "Record Version",
            "type": "integer"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "record_version",
          "roles",
          "permissions"
        ],
        "title": "Workspace",
        "type": "object"
      }
