{
  "components": {
    "schemas": {
      "Component": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "healthy",
              "not_configured"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "title": "Component",
        "type": "object"
      },
      "Envelope_FoundationHealth_": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/FoundationHealth"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "Envelope[FoundationHealth]",
        "type": "object"
      },
      "Envelope_Profile_": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Profile"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "Envelope[Profile]",
        "type": "object"
      },
      "Envelope_Workspace_": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Workspace"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "Envelope[Workspace]",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "retryable"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "FoundationHealth": {
        "additionalProperties": false,
        "properties": {
          "components": {
            "items": {
              "$ref": "#/components/schemas/Component"
            },
            "title": "Components",
            "type": "array"
          },
          "live_sending": {
            "const": false,
            "default": false,
            "title": "Live Sending",
            "type": "boolean"
          }
        },
        "required": [
          "components"
        ],
        "title": "FoundationHealth",
        "type": "object"
      },
      "Meta": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "freshness": {
            "default": "current",
            "enum": [
              "current",
              "missing"
            ],
            "title": "Freshness",
            "type": "string"
          },
          "record_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Record Version"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "source": {
            "default": "company_os",
            "title": "Source",
            "type": "string"
          },
          "workspace_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Workspace Id"
          }
        },
        "required": [
          "request_id",
          "as_of"
        ],
        "title": "Meta",
        "type": "object"
      },
      "Probe": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Probe",
        "type": "object"
      },
      "Profile": {
        "additionalProperties": false,
        "properties": {
          "assurance": {
            "title": "Assurance",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "principal_id": {
            "format": "uuid",
            "title": "Principal Id",
            "type": "string"
          },
          "workspaces": {
            "items": {
              "$ref": "#/components/schemas/Workspace"
            },
            "title": "Workspaces",
            "type": "array"
          }
        },
        "required": [
          "principal_id",
          "display_name",
          "assurance",
          "workspaces"
        ],
        "title": "Profile",
        "type": "object"
      },
      "SessionInput": {
        "additionalProperties": false,
        "properties": {
          "csrf_token": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "csrf_token"
        ],
        "title": "SessionInput",
        "type": "object"
      },
      "SessionOutput": {
        "additionalProperties": false,
        "properties": {
          "expires_in": {
            "default": 43200,
            "title": "Expires In",
            "type": "integer"
          },
          "session_token": {
            "title": "Session Token",
            "type": "string"
          }
        },
        "required": [
          "session_token"
        ],
        "title": "SessionOutput",
        "type": "object"
      },
      "Workspace": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "acquisition",
              "client_delivery",
              "partners"
