# Generated local secrets go in .env via npm run setup. Never use production values.
COMPANY_ENV=development
AUTH_MODE=development
CONSOLE_ORIGIN=http://localhost:3000
API_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql+psycopg://company_api:REPLACE@127.0.0.1:55432/company_os
WORKER_DATABASE_URL=postgresql+psycopg://company_worker:REPLACE@127.0.0.1:55432/company_os
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:REPLACE@127.0.0.1:55432/company_os
DEV_AUTH_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
CONSOLE_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
# Managed auth is separately configured after provider preflight, no public signup.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# FAKE PHASE 4 TEST AUTHENTICATION - NOT A PROVIDER GUARANTEE
FAKE_WEBHOOK_SECRET=
